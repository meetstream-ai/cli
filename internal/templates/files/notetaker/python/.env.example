# MeetStream: leave these out on your laptop. The app then calls MeetStream
# through the meetstream CLI with your sign-in, so no key sits in this file.
# On a server, run "meetstream env --with-key" to add your key and API URL.
PORT=8000
LLM_PROVIDER=[[.LLM]]
[[if eq .LLM "anthropic"]]ANTHROPIC_API_KEY=
[[end]][[if eq .LLM "openai"]]OPENAI_API_KEY=
OPENAI_MODEL=
[[end]]EMAIL_PROVIDER=[[.Email]]
[[if ne .Email "none"]]EMAIL_FROM=
EMAIL_TO=
[[end]][[if eq .Email "resend"]]RESEND_API_KEY=
[[end]][[if eq .Email "sendgrid"]]SENDGRID_API_KEY=
[[end]][[if eq .Email "smtp"]]SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
[[end]]