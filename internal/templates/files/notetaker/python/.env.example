[[end]][[if eq .Email "sendgrid"]]SENDGRID_API_KEY=
[[end]][[if eq .Email "smtp"]]SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
[[end]]